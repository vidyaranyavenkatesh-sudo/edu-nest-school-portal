# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Hidden e-mail domain used to turn a Login ID into an e-mail. Nothing is ever sent to it.
# Use the same value in BOTH portals.
NEXT_PUBLIC_LOGIN_DOMAIN=login.invalid

# SECRET: only the School Portal needs this (to create accounts and reset passwords).
# Never put it in the Student Portal and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
